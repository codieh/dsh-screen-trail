{
  "name": "@local/dsh-screen-trail",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "description": "Native low-frame-rate capture with batched visual analysis and activity-level summaries.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json",
    "pretest": "npm run build",
    "test": "node --test --test-timeout=10000",
    "prepack": "npm run build"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "native",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
