{
  "name": "@local/dsh-screen-trail",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "description": "Native low-frame-rate capture with batched visual analysis and activity-level summaries.",
  "scripts": {
    "test": "node --test --test-timeout=10000"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "frames.js",
    "trail.js",
    "analysis-response.js",
    "capture.js",
    "native",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
